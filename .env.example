# Copy to .env and fill in. .env is gitignored; this template is committed.
# Loaded automatically by src/repro.py and src/models.py (python-dotenv).

# --- Reproducibility ---------------------------------------------------------
# Master seed for the whole pipeline. Every stochastic script routes through
# this via src.repro.get_seed(). Default is 0, which reproduces the numbers
# reported in the paper. Change it to re-run under a different draw.
SEED=0

# Seeds for a multi-seed sweep (comma-separated). Used by
# analysis/sanity/seed_sweep.py to report mean +/- std across seeds, e.g.:
#   SEEDS=0,1,2,3,4
# If unset, sweeps fall back to a single run at SEED.
SEEDS=0,1,2,3,4

# Force torch's deterministic algorithms (1/true to enable). Off by default:
# it can raise on a few CUDA ops and is slower. cudnn determinism is always on.
DETERMINISTIC=0

# --- Models / data -----------------------------------------------------------
# HuggingFace access token (required for the gated meta-llama checkpoints).
HF_TOKEN=

# Optional: relocate the HuggingFace cache (model + dataset downloads).
# HF_HOME=

# Model precision override. This is the variable documented in the README and
# honoured by src/models.py:ModelLoader; it overrides whatever quantization the
# calling script asked for. Accepted: fp16 | bf16 | 8bit | 4bit.
# The sc2_* scripts hardcode 4-bit for a 12 GB card, so set this to fp16 to
# reproduce the numbers reported in the paper.
# MI_PRECISION=fp16

# Legacy alias honoured only by src/analysis_utils.py:load_model_wrapped().
# Prefer MI_PRECISION above; this is kept so older invocations still work.
# MECH_INTERP_PRECISION=
